# Copy to .env or set as environment variables / Azure App Settings. No secrets are required.
SIMULATOR_ENABLED=1
SIM_INTERVAL_SECONDS=5
# SIM_SEED=42                       # fixed seed => reproducible simulation
RETENTION_MAX_ROWS=20000
LOG_LEVEL=INFO
# SMARTCITY_DATA_DIR=./data         # database + model location
# SQLITE_JOURNAL_MODE=WAL           # use DELETE on Azure (/home is a network share)
HOST=127.0.0.1
PORT=5000
